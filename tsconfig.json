{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "rtl-text-transform": ["./src/index.ts"],
      "rtl-text-transform/react": ["./src/react.tsx"]
    },
    "types": ["node", "vitest/globals"]
  },
  "include": ["src", "demo", "tests", "vite.config.ts", "vitest.config.ts", "tsup.config.ts"]
}
